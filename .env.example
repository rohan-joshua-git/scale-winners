# TrustSphere risk-triage prototype — example environment file
# Copy to .env and fill in real values locally. Never commit the real .env.
#
# Tonight's build uses proxies for all SAP products (see README), so none of these
# are required to run the prototype — placeholders only, for the later real-SAP swap.

# SAP HANA Cloud (real tenant creds live in team_07_credentials.json, gitignored)
HANA_HOST=your-hana-host.hanacloud.ondemand.com
HANA_PORT=443
HANA_USER=your_username
HANA_PASSWORD=your_password

# SAP AI Core (real tenant creds live in team_07_credentials.json, gitignored)
AI_CORE_CLIENT_ID=your_client_id
AI_CORE_CLIENT_SECRET=your_client_secret
AI_CORE_AUTH_URL=https://your-subaccount.authentication.sap.hana.ondemand.com
AI_CORE_RESOURCE_GROUP=default

# Scoring service (FastAPI, PROXY for SAP BTP)
SCORING_SERVICE_HOST=127.0.0.1
SCORING_SERVICE_PORT=8000
